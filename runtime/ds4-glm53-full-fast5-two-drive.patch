+// GLM-5.3 approximate expert routing (experimental). Every switch below is
+// off by default; with all of them unset, decoding is unchanged. Values are
+// read from the environment once and cached.
+static uint32_t ds4_glm_fast_routing_env_u32(const char *name) {
+    const char *env = getenv(name);
+    if (!env || !env[0]) return 0;
+    char *end = NULL;
+    long v = strtol(env, &end, 10);
+    if (end == env || *end != '\0' || v <= 0 || v > 256) return 0;
+    return (uint32_t)v;
+}
+
+// DS4_GLM_APPROX_WARMUP_TOKENS=N (default 0 = off) turns the approximate
+// routing below (DS4_GLM_CACHE_AWARE_MIN/_TAU/_MASS and DS4_GLM_SUBST) off
+// for the first N decode steps of every generation, so those steps make the
+// same expert selection as exact decoding; the approximation resumes from
+// step N onward. The approximate modes decide what to drop or substitute
+// partly from the current expert-cache contents, and those depend on
+// earlier requests. In one reproduced case, a particular request history
+// made the approximation derail an answer from its second generated token;
+// making the first decode steps exact fixed that case. Next-layer prefetch
+// and other cache behavior are not affected by this switch.
+//
+// Steps are counted with one file-scope counter. That is correct as long as
+// only one generation decodes at a time in the process: the CLI decode loop,
+// and ds4-server in its default mode, where decoding is serialized by its
+// inference mutex. With --batched-sessions the server decodes several
+// sessions concurrently and they would share this counter, so the warm-up
+// window is not tracked correctly in that mode.
+//
+// ds4_glm_approx_warmup_reset() is called once at the start of a generation
+// and ds4_glm_approx_warmup_note_step() once after each decode eval, in
+// ds4.c generate_glm_metal_argmax() (CLI generation) and ds4_server.c
+// generate_job_inner() (one HTTP request). Other paths, including perplexity
+// scoring, are not wired; there the counter stays at 0, so with the variable
+// set every step is exact.
+static uint32_t ds4_glm_approx_warmup_tokens(void) {
+    static int checked = 0;
+    static uint32_t v = 0;
+    if (!checked) {
+        v = ds4_glm_fast_routing_env_u32("DS4_GLM_APPROX_WARMUP_TOKENS");
+        checked = 1;
+    }
+    return v;
+}
+
+static uint32_t g_glm_approx_warmup_step = 0;
+
+// True while the current decode step is inside the warm-up window (step < N).
+static int ds4_glm_approx_warmup_active(void) {
+    const uint32_t n = ds4_glm_approx_warmup_tokens();
+    return n != 0 && g_glm_approx_warmup_step < n;
+}
+
+// Call once at the start of every generation.
+void ds4_glm_approx_warmup_reset(void) {
+    g_glm_approx_warmup_step = 0;
+}
+
+// Call once after each decode eval (one generated token). It must run after
+// the eval, because the getters below read the counter during the eval.
+void ds4_glm_approx_warmup_note_step(void) {
+    g_glm_approx_warmup_step++;
+}
+
+// Number of decode steps since the last reset that ran forced-exact.
+uint64_t ds4_glm_approx_warmup_forced_this_gen(void) {
+    const uint32_t n = ds4_glm_approx_warmup_tokens();
+    return g_glm_approx_warmup_step < n ? g_glm_approx_warmup_step : n;
+}
+
+// DS4_GLM_CACHE_AWARE_MIN=m. Applies to the single-token decode MoE path
+// (ds4_gpu_routed_moe_one_tensor). Slots ranked < m always load. A slot
+// ranked >= m is used only if its expert is already in the streaming expert
+// cache; a cache miss there is dropped (no SSD read) and aliased to slot 0
+// with weight 0. 0 (unset) = off.
+static uint32_t ds4_glm_cache_aware_min_m(void) {
+    // Forced off during the warm-up window.
+    if (ds4_glm_approx_warmup_active()) return 0;
+    static int checked = 0;
+    static uint32_t v = 0;
+    if (!checked) {
+        v = ds4_glm_fast_routing_env_u32("DS4_GLM_CACHE_AWARE_MIN");
+        checked = 1;
+    }
+    return v;
+}
+
+// DS4_GLM_CACHE_AWARE_TAU=tau. A missing slot ranked >= m is loaded instead
+// of dropped if its normalized router weight (before the router's
+// expert_weight_scale multiply) is >= tau. The weights buffer holds the
+// scaled value, so the comparison is stored_weight >= tau *
+// DS4_GLM_EXPERT_WEIGHT_SCALE. 0 (unset) disables the rescue.
+#define DS4_GLM_EXPERT_WEIGHT_SCALE 2.5f
+static float ds4_glm_cache_aware_tau(void) {
+    // Forced off during the warm-up window.
+    if (ds4_glm_approx_warmup_active()) return 0.0f;
+    static int checked = 0;
+    static float v = 0.0f;
+    if (!checked) {
+        const char *env = getenv("DS4_GLM_CACHE_AWARE_TAU");
+        if (env && env[0]) {
+            char *end = NULL;
+            double parsed = strtod(env, &end);
+            if (end != env && *end == '\0' && parsed > 0.0 && parsed < 1.0) {
+                v = (float)parsed;
+            }
+        }
+        checked = 1;
+    }
+    return v;
+}
+
+// DS4_GLM_CACHE_AWARE_MASS=p (0 < p <= 1; unset = off): mass-coverage drop.
+// When set, it replaces DS4_GLM_CACHE_AWARE_MIN/_TAU entirely. See
+// ds4_glm_cache_aware_mass_select() for the rule.
+static float ds4_glm_cache_aware_mass_p(void) {
+    // Forced off during the warm-up window.
+    if (ds4_glm_approx_warmup_active()) return 0.0f;
+    static int checked = 0;
+    static float v = 0.0f;
+    if (!checked) {
+        const char *env = getenv("DS4_GLM_CACHE_AWARE_MASS");
+        if (env && env[0]) {
+            char *end = NULL;
+            double parsed = strtod(env, &end);
+            if (end != env && *end == '\0' && parsed > 0.0 && parsed <= 1.0) {
+                v = (float)parsed;
+            }
+        }
+        checked = 1;
+    }
+    return v;
+}
+
+// Mass-coverage slot selection, shared by the early-load path
+// (ds4_gpu_stream_expert_cache_begin_selected_load, residency from its own
+// cache lookup) and the consumption path (ds4_gpu_routed_moe_one_tensor,
+// freshly peeked residency). Resident slots always count toward the used
+// router-weight mass. Missing slots are kept in rank order while that mass
+// is below p, and dropped after; rank 0 is always kept. ids[] must be in
+// rank order. Returns the bitmask of slots to drop (weight 0 + alias).
+static uint32_t ds4_glm_cache_aware_mass_select(
+        float p,
+        uint32_t n_expert,
+        uint32_t resident_mask,
+        uint32_t missing_mask,
+        const float *weights_prescale) {
+    if (p <= 0.0f || p > 1.0f || n_expert == 0) return 0;
+    float mass_used = 0.0f;
+    for (uint32_t i = 0; i < n_expert; i++) {
+        if ((resident_mask & (1u << i)) != 0) {
+            mass_used += weights_prescale[i];
+        }
+    }
+    uint32_t dropped = 0;
+    for (uint32_t i = 0; i < n_expert; i++) {
+        if ((missing_mask & (1u << i)) == 0) continue; // resident, already counted
+        if (i == 0) {
+            // rank 0 (top-1) is always used.
+            mass_used += weights_prescale[0];
+            continue;
+        }
+        if (mass_used < p) {
+            mass_used += weights_prescale[i];
+        } else {
+            dropped |= (1u << i);
+        }
+    }
+    return dropped;
+}
+
+// DS4_GLM_SUBST=router. For each slot the cache-aware drop above decided to
+// drop, use instead the already-cached expert (no extra SSD read; the lookup
+// is ds4_gpu_stream_expert_cache_peek()) with the highest raw router
+// probability that is not already used by this token's other slots or
+// claimed by an earlier substitute. The dropped slot's own normalized weight
+// is kept for the substitute. If no candidate is cached, the slot falls back
+// to the alias-to-slot-0 / weight-0 behavior. Unset = off.
+typedef enum {
+    DS4_GLM_SUBST_OFF    = 0,
+    DS4_GLM_SUBST_ROUTER = 1,
+} ds4_glm_subst_mode_t;
+
+static ds4_glm_subst_mode_t ds4_glm_subst_mode(void) {
+    // Forced off during the warm-up window. SUBST only acts on slots the drop
+    // logic dropped, which is already off then; this keeps it explicit.
+    if (ds4_glm_approx_warmup_active()) return DS4_GLM_SUBST_OFF;
+    static int checked = 0;
+    static ds4_glm_subst_mode_t mode = DS4_GLM_SUBST_OFF;
+    if (!checked) {
+        checked = 1;
+        const char *env = getenv("DS4_GLM_SUBST");
+        if (env && env[0]) {
+            if (strcmp(env, "router") == 0) mode = DS4_GLM_SUBST_ROUTER;
+        }
+    }
+    return mode;
+}
+
+// Recorded by ds4_gpu_glm_router_select_tensor() (the single-token decode
+// router), only when DS4_GLM_SUBST is on, and read by
+// ds4_gpu_routed_moe_one_tensor for the same layer later in the same token's
+// single-threaded dispatch.
+static ds4_gpu_tensor *g_glm_subst_router_probs_tensor = NULL;
+static uint32_t         g_glm_subst_router_probs_n_expert = 0;
+
+static void ds4_glm_subst_note_router_probs(ds4_gpu_tensor *probs, uint32_t n_expert) {
+    g_glm_subst_router_probs_tensor = probs;
+    g_glm_subst_router_probs_n_expert = n_expert;
+}
+
+// CPU-visible pointer to the n_expert raw sigmoid probabilities from the most
+// recent decode router call, or NULL if unavailable. The probs buffer is
+// shared storage, and the router's command buffer has already completed when
+// the drop path reaches this point, so no extra synchronization is needed.
+static const float *ds4_glm_subst_router_probs_ptr(uint32_t want_n_expert) {
+    if (!g_glm_subst_router_probs_tensor ||
+        g_glm_subst_router_probs_n_expert < want_n_expert) {
+        return NULL;
+    }
+    id<MTLBuffer> pb = ds4_gpu_tensor_buffer(g_glm_subst_router_probs_tensor);
+    if (!pb) return NULL;
+    uint8_t *base = (uint8_t *)[pb contents];
+    if (!base) return NULL;
+    return (const float *)(base + ds4_gpu_tensor_offset(g_glm_subst_router_probs_tensor));
+}
