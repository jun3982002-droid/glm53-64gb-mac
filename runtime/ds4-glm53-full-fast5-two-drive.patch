+#!/usr/bin/env python3
+"""ds4_stripe_build.py -- build/verify manifests for DS4's SSD striping.
+
+Splits each routed-expert tensor slice in a GGUF file (or, for testing, a
+synthetic "pseudo-GGUF") into N contiguous byte ranges according to given
+fractions, writes the head N-1 fractions into sidecar files on other
+drives, and lets the LAST fraction stay in place inside the original file
+(role="tail") so we never have to duplicate the drive the model already
+lives on.
+
+Real usage (GLM-5.3 Full IQ2_XXS example; check free space before building):
+
+    ds4_stripe_build.py build \\
+        --gguf /path/to/GLM-5.3-Full-IQ2_XXS.gguf \\
+        --part /path/on/second-drive/glm53.stripe.part0.bin:0.59 \\
+        --tail-fraction 0.41 \\
+        --align 16384 \\
+        --manifest /path/to/manifest.json
+    ds4_stripe_build.py verify --manifest /path/to/manifest.json
+
+Test usage (no real GGUF, no model weights read or touched):
+
+    ds4_stripe_build.py build \\
+        --source /tmp/pseudo.gguf \\
+        --synthetic 4,8,65536,65536,32768 \\
+        --part /tmp/part0.bin:0.5 \\
+        --tail-fraction 0.5 \\
+        --manifest /tmp/manifest.json
+    ds4_stripe_build.py verify --manifest /tmp/manifest.json --source /tmp/pseudo.gguf
+
+GGUF tensor-info parsing below reimplements the public GGUF binary layout
+(magic/version/kv/tensor-info section) from scratch. The parser reads tensor
+metadata only; it does not modify the source model.
+"""
+import argparse
+import hashlib
+import json
+import os
+import re
+import struct
+import sys
+import time
+
+# ---------------------------------------------------------------------
+# Minimal GGUF header parser (public binary format; independent
+# reimplementation, not copied from the reference scripts).
+# ---------------------------------------------------------------------
+
+_T_UINT8, _T_INT8, _T_UINT16, _T_INT16 = 0, 1, 2, 3
+_T_UINT32, _T_INT32, _T_FLOAT32, _T_BOOL = 4, 5, 6, 7
+_T_STRING, _T_ARRAY, _T_UINT64, _T_INT64, _T_FLOAT64 = 8, 9, 10, 11, 12
+
+_SCALAR_FMT = {
+    _T_UINT8: ("B", 1), _T_INT8: ("b", 1),
+    _T_UINT16: ("H", 2), _T_INT16: ("h", 2),
+    _T_UINT32: ("I", 4), _T_INT32: ("i", 4),
+    _T_FLOAT32: ("f", 4), _T_BOOL: ("B", 1),
+    _T_UINT64: ("Q", 8), _T_INT64: ("q", 8), _T_FLOAT64: ("d", 8),
+}
+
+GGML_TYPE_NAMES = {
+    0: "f32", 1: "f16", 2: "q4_0", 3: "q4_1", 6: "q5_0", 7: "q5_1",
+    8: "q8_0", 9: "q8_1", 10: "q2_k", 11: "q3_k", 12: "q4_k", 13: "q5_k",
+    14: "q6_k", 15: "q8_k", 16: "iq2_xxs", 17: "iq2_xs", 18: "iq3_xxs",
+    19: "iq1_s", 20: "iq4_nl", 21: "iq3_s", 22: "iq2_s", 23: "iq4_xs",
+    24: "i8", 25: "i16", 26: "i32", 27: "i64", 28: "f64", 29: "iq1_m",
+    30: "bf16",
+}
+
+# (block_elems, block_bytes) for the quant types we expect to see in
+# routed-expert tensors. Extend as needed -- production round can widen
+# this if a different quant shows up; unknown types fail loudly instead
+# of silently mis-slicing.
+_TYPE_BLOCK = {
+    "f32": (1, 4), "f16": (1, 2), "bf16": (1, 2),
+    "q8_0": (32, 34),
+    "q4_k": (256, 144), "q5_k": (256, 176), "q6_k": (256, 210),
+    "q2_k": (256, 84),
+    "iq2_xxs": (256, 66), "iq2_xs": (256, 74), "iq2_s": (256, 82),
+    "iq3_xxs": (256, 98), "iq3_s": (256, 110),
+    "iq4_nl": (32, 18), "iq4_xs": (256, 136),
+}
+
+
+class _Reader:
+    def __init__(self, data):
+        self.data = data
+        self.off = 0
+
+    def read(self, n):
+        b = self.data[self.off:self.off + n]
+        if len(b) < n:
+            raise EOFError(f"need {n} bytes at {self.off}, have {len(self.data)}")
+        self.off += n
+        return b
+
+    def u32(self):
+        return struct.unpack("<I", self.read(4))[0]
+
+    def u64(self):
+        return struct.unpack("<Q", self.read(8))[0]
+
+    def string(self):
+        n = self.u64()
+        return self.read(n).decode("utf-8", errors="replace")
+
+    def value(self, vtype):
+        if vtype == _T_STRING:
+            return self.string()
+        if vtype == _T_ARRAY:
+            atype = self.u32()
+            n = self.u64()
+            return [self.value(atype) for _ in range(n)]
+        if vtype in _SCALAR_FMT:
+            fmt, size = _SCALAR_FMT[vtype]
+            return struct.unpack("<" + fmt, self.read(size))[0]
+        raise ValueError(f"unknown GGUF value type {vtype}")
+
+
+def gguf_parse_header(path, max_bytes=256 * 1024 * 1024):
+    with open(path, "rb") as f:
+        data = f.read(max_bytes)
+    r = _Reader(data)
+    magic = r.read(4)
+    if magic != b"GGUF":
+        raise ValueError(f"{path}: not a GGUF file (magic={magic!r})")
+    version = r.u32()
+    n_tensors = r.u64()
+    n_kv = r.u64()
+    meta = {}
+    for _ in range(n_kv):
+        key = r.string()
+        vtype = r.u32()
+        meta[key] = r.value(vtype)
+    tensors = []
+    for _ in range(n_tensors):
+        name = r.string()
+        n_dims = r.u32()
+        dims = [r.u64() for _ in range(n_dims)]
+        ttype = r.u32()
+        offset = r.u64()
+        tensors.append({
+            "name": name,
+            "dims": dims,
+            "type": GGML_TYPE_NAMES.get(ttype, ttype),
+            "offset": offset,
+        })
+    return version, meta, tensors, r.off
+
+
+def data_start_offset(header_bytes_consumed, alignment=32):
+    return ((header_bytes_consumed + alignment - 1) // alignment) * alignment
+
+
+def row_bytes(ne0, gtype):
+    if gtype not in _TYPE_BLOCK:
+        raise ValueError(f"unsupported ggml type for row-byte math: {gtype}")
+    block_elems, block_bytes = _TYPE_BLOCK[gtype]
+    if ne0 % block_elems != 0:
+        raise ValueError(f"ne0={ne0} not divisible by block_elems={block_elems} for {gtype}")
+    return (ne0 // block_elems) * block_bytes
+
+
+_ROUTED_EXPERT_RE = re.compile(
+    r"^blk\.(\d+)\.ffn_(gate|up|down)_exps\.weight$")
+
+
+def enumerate_routed_expert_slices_from_gguf(path):
+    """Return (source_size, list of slice dicts) for every expert in every
+    routed ffn_{gate,up,down}_exps.weight tensor. Each slice dict has:
+    off, len (absolute byte range in the GGUF file), layer, kind, expert.
+    """
+    version, meta, tensors, header_bytes = gguf_parse_header(path)
+    del version
+    alignment = int(meta.get("general.alignment", 32))
+    data_start = data_start_offset(header_bytes, alignment)
+    source_size = os.path.getsize(path)
+
+    slices = []
+    for t in tensors:
+        m = _ROUTED_EXPERT_RE.match(t["name"])
+        if not m:
+            continue
+        layer = int(m.group(1))
+        kind = m.group(2)
+        dims = t["dims"]
+        if len(dims) != 3:
+            raise ValueError(f"expected 3-D routed expert tensor, got {dims} for {t['name']}")
+        ne0, ne1, n_expert = dims
+        gtype = t["type"]
+        rb = row_bytes(ne0, gtype)
+        expert_bytes = rb * ne1
+        base = data_start + t["offset"]
+        for e in range(n_expert):
+            off = base + e * expert_bytes
+            slices.append({
+                "off": off, "len": expert_bytes,
+                "layer": layer, "kind": kind, "expert": e,
+            })
+    return source_size, slices
+
+
+def enumerate_synthetic_slices(spec, base_off=0):
+    """spec = "n_layers,n_expert,gate_bytes,up_bytes,down_bytes" laid out
+    back-to-back starting at base_off, mimicking the real per-layer
+    ffn_{gate,up,down}_exps.weight container-tensor layout closely enough
+    to exercise the same slicing/striping code paths without a real GGUF.
+    """
+    n_layers, n_expert, gate_bytes, up_bytes, down_bytes = (int(x) for x in spec.split(","))
+    slices = []
+    cursor = base_off
+    for layer in range(n_layers):
+        for kind, per_expert_bytes in (("gate", gate_bytes), ("up", up_bytes), ("down", down_bytes)):
+            for e in range(n_expert):
+                slices.append({
+                    "off": cursor, "len": per_expert_bytes,
+                    "layer": layer, "kind": kind, "expert": e,
+                })
+                cursor += per_expert_bytes
+    return cursor, slices  # cursor == total bytes consumed
+
+
+# ---------------------------------------------------------------------
+# Striping math + manifest / sidecar writer.
+# ---------------------------------------------------------------------
+
+def plan_stripe(slice_len, fractions, align):
+    """Split [0, slice_len) into len(fractions) consecutive chunks whose
+    boundaries are rounded to multiples of `align`, in fraction order.
+    The last chunk absorbs any rounding remainder. Returns a list of
+    (local_off, local_len) covering [0, slice_len) with no gaps/overlaps.
+    """
+    n = len(fractions)
+    assert n >= 1
+    if slice_len == 0:
+        return [(0, 0)] * n
+    boundaries = [0]
+    acc = 0.0
+    for f in fractions[:-1]:
+        acc += f
+        raw = int(round(slice_len * acc))
+        if align > 1:
+            raw = (raw // align) * align
+        raw = max(boundaries[-1], min(raw, slice_len))
+        boundaries.append(raw)
+    boundaries.append(slice_len)
+    chunks = []
+    for i in range(n):
+        lo, hi = boundaries[i], boundaries[i + 1]
+        chunks.append((lo, hi - lo))
+    return chunks
+
+
+def build_manifest(source_path, source_size, slices, part_specs, align,
+                    manifest_path, source_mtime=None, sha_head=None):
+    """part_specs: list of dicts, each {"file": path, "fraction": float,
+    "tail": bool}. Exactly the last entry may have tail=True, meaning it
+    reads straight out of source_path at the slice's own natural offset
+    (no sidecar file is written for it).
+    """
+    n_parts = len(part_specs)
+    fractions = [p["fraction"] for p in part_specs]
+    total_frac = sum(fractions)
+    if abs(total_frac - 1.0) > 1e-6:
+        raise ValueError(f"fractions must sum to 1.0, got {total_frac}")
+
+    tail_indices = [i for i, p in enumerate(part_specs) if p.get("tail")]
+    if len(tail_indices) > 1:
+        raise ValueError("at most one part may be role=tail")
+    tail_index = tail_indices[0] if tail_indices else None
+    if tail_index is not None and tail_index != n_parts - 1:
+        raise ValueError("the tail part must be the last part")
+
+    sidecar_fds = {}
+    sidecar_cursors = {}
+    for i, p in enumerate(part_specs):
+        if i == tail_index:
+            continue
+        os.makedirs(os.path.dirname(os.path.abspath(p["file"])) or ".", exist_ok=True)
+        sidecar_fds[i] = open(p["file"], "wb")
+        sidecar_cursors[i] = 0
+
+    with open(source_path, "rb") as src:
+        manifest_slices = []
+        for s in slices:
+            chunks = plan_stripe(s["len"], fractions, align)
+            parts_out = []
+            local_cursor = 0
+            for i, (local_off, local_len) in enumerate(chunks):
+                if i == tail_index:
+                    file_off = s["off"] + local_off
+                    parts_out.append({"part": i, "file_off": file_off, "len": local_len})
+                else:
+                    if local_len > 0:
+                        src.seek(s["off"] + local_off)
+                        buf = src.read(local_len)
+                        if len(buf) != local_len:
+                            raise IOError(f"short read building sidecar for slice off={s['off']}")
+                        sidecar_fds[i].write(buf)
+                    file_off = sidecar_cursors[i]
+                    sidecar_cursors[i] += local_len
+                    parts_out.append({"part": i, "file_off": file_off, "len": local_len})
+                local_cursor += local_len
+            assert local_cursor == s["len"]
+            manifest_slices.append({
+                "off": s["off"], "len": s["len"],
+                "layer": s.get("layer"), "kind": s.get("kind"), "expert": s.get("expert"),
+                "parts": parts_out,
+            })
+
+    for fd in sidecar_fds.values():
+        fd.close()
+
+    parts_manifest = []
+    for i, p in enumerate(part_specs):
+        entry = {"index": i, "file": os.path.abspath(p["file"]) if i != tail_index else os.path.abspath(source_path)}
+        if i == tail_index:
+            entry["role"] = "tail"
+        else:
+            entry["role"] = "sidecar"
+        entry["fraction"] = p["fraction"]
+        parts_manifest.append(entry)
+
+    manifest = {
+        "version": 1,
+        "created": time.strftime("%Y-%m-%dT%H:%M:%S%z"),
+        "source": {
+            "path": os.path.abspath(source_path),
+            "size": source_size,
+        },
+        "align": align,
+        "parts": parts_manifest,
+        "slices": manifest_slices,
+    }
+    if source_mtime is not None:
+        manifest["source"]["mtime"] = source_mtime
+    if sha_head is not None:
+        manifest["source"]["sha256_head_1mib"] = sha_head
+
+    os.makedirs(os.path.dirname(os.path.abspath(manifest_path)) or ".", exist_ok=True)
+    with open(manifest_path, "w") as f:
+        json.dump(manifest, f)
+    return manifest
+
+
+def sha256_head(path, n=1024 * 1024):
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        h.update(f.read(n))
+    return h.hexdigest()
+
+
+def verify_manifest(manifest_path, sample=None, seed=0):
+    with open(manifest_path, "r") as f:
+        manifest = json.load(f)
+
+    part_fds = {}
+    for p in manifest["parts"]:
+        part_fds[p["index"]] = open(p["file"], "rb")
+
+    source_path = manifest["source"]["path"]
+    src = open(source_path, "rb")
+
+    slices = manifest["slices"]
+    indices = range(len(slices))
+    if sample is not None and sample < len(slices):
+        import random
+        rnd = random.Random(seed)
+        indices = sorted(rnd.sample(range(len(slices)), sample))
+
+    n_checked = 0
+    n_bytes = 0
+    first_mismatch = None
+    for idx in indices:
+        s = slices[idx]
+        src.seek(s["off"])
+        expected = src.read(s["len"])
+        got = bytearray()
+        for part in s["parts"]:
+            fd = part_fds[part["part"]]
+            fd.seek(part["file_off"])
+            chunk = fd.read(part["len"])
+            if len(chunk) != part["len"]:
+                first_mismatch = first_mismatch or (idx, "short-read", part)
+            got.extend(chunk)
+        if bytes(got) != expected:
+            if first_mismatch is None:
+                # find first differing byte for a useful report
+                diff_at = next((i for i in range(min(len(got), len(expected))) if got[i] != expected[i]), min(len(got), len(expected)))
+                first_mismatch = (idx, "byte-mismatch", diff_at)
+        n_checked += 1
+        n_bytes += s["len"]
+
+    src.close()
+    for fd in part_fds.values():
+        fd.close()
+
+    return {
+        "slices_checked": n_checked,
+        "bytes_checked": n_bytes,
+        "total_slices": len(slices),
+        "ok": first_mismatch is None,
+        "first_mismatch": first_mismatch,
+    }
+
+
+# ---------------------------------------------------------------------
+# CLI
+# ---------------------------------------------------------------------
+
+def _parse_part_arg(s):
+    path, frac = s.rsplit(":", 1)
+    return {"file": path, "fraction": float(frac)}
+
+
+def cmd_build(args):
+    part_specs = [_parse_part_arg(p) for p in args.part]
+    part_specs.append({"file": args.source or args.gguf, "fraction": args.tail_fraction, "tail": True})
+
+    if args.gguf:
+        source_size, slices = enumerate_routed_expert_slices_from_gguf(args.gguf)
+        source_path = args.gguf
+    else:
+        if not args.source or not args.synthetic:
+            print("error: --synthetic mode needs both --source and --synthetic", file=sys.stderr)
+            return 2
+        total_needed, slices = enumerate_synthetic_slices(args.synthetic, base_off=args.synthetic_base)
+        source_path = args.source
+        actual_size = os.path.getsize(source_path)
+        if total_needed > actual_size:
+            print(f"error: synthetic layout needs {total_needed} bytes but {source_path} is only {actual_size}", file=sys.stderr)
+            return 2
+        source_size = actual_size
+
+    st = os.stat(source_path)
+    manifest = build_manifest(
+        source_path, source_size, slices, part_specs, args.align,
+        args.manifest, source_mtime=int(st.st_mtime),
+        sha_head=sha256_head(source_path))
+    print(f"wrote manifest {args.manifest}: parts={len(manifest['parts'])} slices={len(manifest['slices'])}")
+    for p in manifest["parts"]:
+        extra = ""
+        if p["role"] != "tail":
+            sz = os.path.getsize(p["file"])
+            extra = f" sidecar_bytes={sz}"
+        print(f"  part[{p['index']}] role={p['role']} fraction={p['fraction']:.4f} file={p['file']}{extra}")
+    return 0
+
+
+def cmd_verify(args):
+    result = verify_manifest(args.manifest, sample=args.sample)
+    print(json.dumps(result, indent=2))
+    return 0 if result["ok"] else 1
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    sub = ap.add_subparsers(dest="cmd", required=True)
+
+    b = sub.add_parser("build", help="build a stripe manifest + sidecars")
+    b.add_argument("--gguf", help="real GGUF file to enumerate routed experts from")
+    b.add_argument("--source", help="pseudo-GGUF file for --synthetic mode (also the tail part's file)")
+    b.add_argument("--synthetic", help="n_layers,n_expert,gate_bytes,up_bytes,down_bytes")
+    b.add_argument("--synthetic-base", type=int, default=0, help="byte offset where the synthetic layout starts")
+    b.add_argument("--part", action="append", default=[], help="PATH:FRACTION, repeatable, one per non-tail part, in drive order")
+    b.add_argument("--tail-fraction", type=float, required=True, help="fraction of each slice left in place in the source file")
+    b.add_argument("--align", type=int, default=16384)
+    b.add_argument("--manifest", required=True)
+    b.set_defaults(func=cmd_build)
+
+    v = sub.add_parser("verify", help="verify a manifest's sidecars reconstruct the source bytes exactly")
+    v.add_argument("--manifest", required=True)
+    v.add_argument("--sample", type=int, default=None, help="check a random sample of N slices instead of all of them")
+    v.set_defaults(func=cmd_verify)
+
+    args = ap.parse_args()
+    sys.exit(args.func(args))
+
+
+if __name__ == "__main__":
+    main()
