new file mode 100644
index 0000000..6c3b811
--- /dev/null
+++ b/ds4_stripe.c
@@ -0,0 +1,859 @@
+#include "ds4_stripe.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <inttypes.h>
+#include <limits.h>
+#include <pthread.h>
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+/* ------------------------------------------------------------------ */
+/* Minimal JSON reader (subset: object/array/string/number/bool/null). */
+/* Only used to load our own manifest files written by                */
+/* tools/ds4_stripe_build.py -- not a general-purpose JSON library.    */
+/* ------------------------------------------------------------------ */
+
+typedef enum {
+    JV_NULL, JV_BOOL, JV_NUM, JV_STR, JV_ARR, JV_OBJ
+} ds4_jtype;
+
+typedef struct ds4_jvalue {
+    ds4_jtype type;
+    double num;
+    int boolean;
+    char *str;
+    struct ds4_jvalue **items;
+    size_t n_items;
+    char **keys;
+    struct ds4_jvalue **vals;
+    size_t n_kv;
+} ds4_jvalue;
+
+typedef struct {
+    const char *s;
+    size_t len;
+    size_t pos;
+    int error;
+} ds4_jparser;
+
+static void ds4_jv_free(ds4_jvalue *v) {
+    if (!v) return;
+    size_t i;
+    switch (v->type) {
+        case JV_STR:
+            free(v->str);
+            break;
+        case JV_ARR:
+            for (i = 0; i < v->n_items; i++) ds4_jv_free(v->items[i]);
+            free(v->items);
+            break;
+        case JV_OBJ:
+            for (i = 0; i < v->n_kv; i++) {
+                free(v->keys[i]);
+                ds4_jv_free(v->vals[i]);
+            }
+            free(v->keys);
+            free(v->vals);
+            break;
+        default:
+            break;
+    }
+    free(v);
+}
+
+static void ds4_jskip_ws(ds4_jparser *p) {
+    while (p->pos < p->len) {
+        char c = p->s[p->pos];
+        if (c == ' ' || c == '\t' || c == '\n' || c == '\r') {
+            p->pos++;
+        } else {
+            break;
+        }
+    }
+}
+
+static ds4_jvalue *ds4_jv_new(ds4_jtype t) {
+    ds4_jvalue *v = (ds4_jvalue *)calloc(1, sizeof(ds4_jvalue));
+    if (v) v->type = t;
+    return v;
+}
+
+static ds4_jvalue *ds4_jparse_value(ds4_jparser *p);
+
+static char *ds4_jparse_string_raw(ds4_jparser *p) {
+    if (p->pos >= p->len || p->s[p->pos] != '"') { p->error = 1; return NULL; }
+    p->pos++;
+    size_t cap = 32, n = 0;
+    char *buf = (char *)malloc(cap);
+    if (!buf) { p->error = 1; return NULL; }
+    while (p->pos < p->len && p->s[p->pos] != '"') {
+        char c = p->s[p->pos++];
+        if (c == '\\') {
+            if (p->pos >= p->len) { p->error = 1; free(buf); return NULL; }
+            char e = p->s[p->pos++];
+            switch (e) {
+                case '"': c = '"'; break;
+                case '\\': c = '\\'; break;
+                case '/': c = '/'; break;
+                case 'n': c = '\n'; break;
+                case 't': c = '\t'; break;
+                case 'r': c = '\r'; break;
+                case 'b': c = '\b'; break;
+                case 'f': c = '\f'; break;
+                case 'u': {
+                    /* Best-effort: skip 4 hex digits, emit '?'. Manifest
+                     * paths/strings are not expected to use \u escapes. */
+                    if (p->pos + 4 > p->len) { p->error = 1; free(buf); return NULL; }
+                    p->pos += 4;
+                    c = '?';
+                    break;
+                }
+                default: c = e; break;
+            }
+        }
+        if (n + 1 >= cap) {
+            cap *= 2;
+            char *nb = (char *)realloc(buf, cap);
+            if (!nb) { free(buf); p->error = 1; return NULL; }
+            buf = nb;
+        }
+        buf[n++] = c;
+    }
+    if (p->pos >= p->len) { p->error = 1; free(buf); return NULL; }
+    p->pos++; /* closing quote */
+    buf[n] = '\0';
+    return buf;
+}
+
+static ds4_jvalue *ds4_jparse_array(ds4_jparser *p) {
+    ds4_jvalue *v = ds4_jv_new(JV_ARR);
+    p->pos++; /* '[' */
+    ds4_jskip_ws(p);
+    if (p->pos < p->len && p->s[p->pos] == ']') { p->pos++; return v; }
+    size_t cap = 4;
+    v->items = (ds4_jvalue **)malloc(cap * sizeof(ds4_jvalue *));
+    for (;;) {
+        ds4_jskip_ws(p);
+        ds4_jvalue *item = ds4_jparse_value(p);
+        if (!item || p->error) { p->error = 1; ds4_jv_free(item); return v; }
+        if (v->n_items >= cap) {
+            cap *= 2;
+            ds4_jvalue **ni = (ds4_jvalue **)realloc(v->items, cap * sizeof(ds4_jvalue *));
+            if (!ni) { p->error = 1; return v; }
+            v->items = ni;
+        }
+        v->items[v->n_items++] = item;
+        ds4_jskip_ws(p);
+        if (p->pos >= p->len) { p->error = 1; return v; }
+        if (p->s[p->pos] == ',') { p->pos++; continue; }
+        if (p->s[p->pos] == ']') { p->pos++; break; }
+        p->error = 1;
+        return v;
+    }
+    return v;
+}
+
+static ds4_jvalue *ds4_jparse_object(ds4_jparser *p) {
+    ds4_jvalue *v = ds4_jv_new(JV_OBJ);
+    p->pos++; /* '{' */
+    ds4_jskip_ws(p);
+    if (p->pos < p->len && p->s[p->pos] == '}') { p->pos++; return v; }
+    size_t cap = 4;
+    v->keys = (char **)malloc(cap * sizeof(char *));
+    v->vals = (ds4_jvalue **)malloc(cap * sizeof(ds4_jvalue *));
+    for (;;) {
+        ds4_jskip_ws(p);
+        char *key = ds4_jparse_string_raw(p);
+        if (!key || p->error) { p->error = 1; free(key); return v; }
+        ds4_jskip_ws(p);
+        if (p->pos >= p->len || p->s[p->pos] != ':') { p->error = 1; free(key); return v; }
+        p->pos++;
+        ds4_jskip_ws(p);
+        ds4_jvalue *val = ds4_jparse_value(p);
+        if (!val || p->error) { p->error = 1; free(key); ds4_jv_free(val); return v; }
+        if (v->n_kv >= cap) {
+            cap *= 2;
+            char **nk = (char **)realloc(v->keys, cap * sizeof(char *));
+            ds4_jvalue **nv = (ds4_jvalue **)realloc(v->vals, cap * sizeof(ds4_jvalue *));
+            if (!nk || !nv) { p->error = 1; return v; }
+            v->keys = nk;
+            v->vals = nv;
+        }
+        v->keys[v->n_kv] = key;
+        v->vals[v->n_kv] = val;
+        v->n_kv++;
+        ds4_jskip_ws(p);
+        if (p->pos >= p->len) { p->error = 1; return v; }
+        if (p->s[p->pos] == ',') { p->pos++; continue; }
+        if (p->s[p->pos] == '}') { p->pos++; break; }
+        p->error = 1;
+        return v;
+    }
+    return v;
+}
+
+static ds4_jvalue *ds4_jparse_value(ds4_jparser *p) {
+    ds4_jskip_ws(p);
+    if (p->pos >= p->len) { p->error = 1; return NULL; }
+    char c = p->s[p->pos];
+    if (c == '{') return ds4_jparse_object(p);
+    if (c == '[') return ds4_jparse_array(p);
+    if (c == '"') {
+        char *s = ds4_jparse_string_raw(p);
+        if (!s) return NULL;
+        ds4_jvalue *v = ds4_jv_new(JV_STR);
+        v->str = s;
+        return v;
+    }
+    if (c == 't' && p->pos + 4 <= p->len && strncmp(p->s + p->pos, "true", 4) == 0) {
+        p->pos += 4;
+        ds4_jvalue *v = ds4_jv_new(JV_BOOL);
+        v->boolean = 1;
+        return v;
+    }
+    if (c == 'f' && p->pos + 5 <= p->len && strncmp(p->s + p->pos, "false", 5) == 0) {
+        p->pos += 5;
+        ds4_jvalue *v = ds4_jv_new(JV_BOOL);
+        v->boolean = 0;
+        return v;
+    }
+    if (c == 'n' && p->pos + 4 <= p->len && strncmp(p->s + p->pos, "null", 4) == 0) {
+        p->pos += 4;
+        return ds4_jv_new(JV_NULL);
+    }
+    if (c == '-' || (c >= '0' && c <= '9')) {
+        size_t start = p->pos;
+        if (p->s[p->pos] == '-') p->pos++;
+        while (p->pos < p->len && isdigit((unsigned char)p->s[p->pos])) p->pos++;
+        if (p->pos < p->len && p->s[p->pos] == '.') {
+            p->pos++;
+            while (p->pos < p->len && isdigit((unsigned char)p->s[p->pos])) p->pos++;
+        }
+        if (p->pos < p->len && (p->s[p->pos] == 'e' || p->s[p->pos] == 'E')) {
+            p->pos++;
+            if (p->pos < p->len && (p->s[p->pos] == '+' || p->s[p->pos] == '-')) p->pos++;
+            while (p->pos < p->len && isdigit((unsigned char)p->s[p->pos])) p->pos++;
+        }
+        char numbuf[64];
+        size_t n = p->pos - start;
+        if (n >= sizeof(numbuf)) { p->error = 1; return NULL; }
+        memcpy(numbuf, p->s + start, n);
+        numbuf[n] = '\0';
+        ds4_jvalue *v = ds4_jv_new(JV_NUM);
+        v->num = atof(numbuf);
+        return v;
+    }
+    p->error = 1;
+    return NULL;
+}
+
+static ds4_jvalue *ds4_jparse(const char *s, size_t len) {
+    ds4_jparser p = { s, len, 0, 0 };
+    ds4_jvalue *v = ds4_jparse_value(&p);
+    ds4_jskip_ws(&p);
+    if (p.error) { ds4_jv_free(v); return NULL; }
+    return v;
+}
+
+static const ds4_jvalue *ds4_jobj_get(const ds4_jvalue *obj, const char *key) {
+    if (!obj || obj->type != JV_OBJ) return NULL;
+    size_t i;
+    for (i = 0; i < obj->n_kv; i++) {
+        if (strcmp(obj->keys[i], key) == 0) return obj->vals[i];
+    }
+    return NULL;
+}
+
+static uint64_t ds4_jnum_u64(const ds4_jvalue *v, uint64_t defval) {
+    if (!v || v->type != JV_NUM) return defval;
+    if (v->num < 0) return defval;
+    return (uint64_t)(v->num + 0.5);
+}
+
+static uint32_t ds4_jnum_u32(const ds4_jvalue *v, uint32_t defval) {
+    uint64_t u = ds4_jnum_u64(v, (uint64_t)defval);
+    return u > UINT32_MAX ? UINT32_MAX : (uint32_t)u;
+}
+
+static const char *ds4_jstr(const ds4_jvalue *v, const char *defval) {
+    if (!v || v->type != JV_STR) return defval;
+    return v->str;
+}
+
+/* ------------------------------------------------------------------ */
+/* Manifest model.                                                     */
+/* ------------------------------------------------------------------ */
+
+#define DS4_STRIPE_MAX_PARTS 8u
+
+typedef struct {
+    uint32_t part_index;
+    uint64_t file_off;
+    uint64_t len;
+} ds4_stripe_slice_part;
+
+typedef struct {
+    uint64_t off;   /* absolute byte offset in the original GGUF */
+    uint64_t len;   /* byte length of this expert-tensor slice   */
+    uint32_t n_parts;
+    ds4_stripe_slice_part parts[DS4_STRIPE_MAX_PARTS];
+} ds4_stripe_slice;
+
+typedef struct {
+    char *file;
+    char *role; /* "sidecar" or "tail", diagnostic only */
+    int fd;
+} ds4_stripe_part;
+
+/* ---- per-part worker pool: one persistent pool per drive/part, so   */
+/* that N parts genuinely read concurrently instead of one thread      */
+/* hopping between files. ---------------------------------------------*/
+
+typedef struct ds4_stripe_join {
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    uint32_t remaining;
+    int all_ok;
+} ds4_stripe_join;
+
+typedef struct ds4_stripe_subtask_node {
+    uint32_t part_index;
+    uint64_t file_off;
+    uint64_t len;
+    uint8_t *dst;
+    ds4_stripe_join *join;
+    struct ds4_stripe_subtask_node *next;
+} ds4_stripe_subtask_node;
+
+typedef struct {
+    pthread_mutex_t mutex;
+    pthread_cond_t cond;
+    ds4_stripe_subtask_node *head;
+    ds4_stripe_subtask_node *tail;
+    pthread_t *threads;
+    uint32_t n_threads;
+    int shutdown;
+    int started;
+} ds4_stripe_part_pool;
+
+static ds4_stripe_part g_parts[DS4_STRIPE_MAX_PARTS];
+static uint32_t g_n_parts;
+static ds4_stripe_part_pool g_pools[DS4_STRIPE_MAX_PARTS];
+
+static ds4_stripe_slice *g_slices;
+static uint32_t g_n_slices;
+static uint64_t g_align = 16384;
+
+static int g_enabled;
+static pthread_once_t g_once = PTHREAD_ONCE_INIT;
+static pthread_mutex_t g_admin_mutex = PTHREAD_MUTEX_INITIALIZER;
+
+static char g_last_error[512];
+
+static void ds4_stripe_set_error(const char *fmt, ...) {
+    va_list ap;
+    va_start(ap, fmt);
+    vsnprintf(g_last_error, sizeof(g_last_error), fmt, ap);
+    va_end(ap);
+}
+
+const char *ds4_stripe_last_error(void) {
+    return g_last_error;
+}
+
+static int ds4_stripe_pread_exact(int fd, uint64_t offset, uint64_t len,
+                                  uint8_t *dst, uint64_t *out_read) {
+    uint64_t pos = 0;
+    if (out_read) *out_read = 0;
+    if (fd < 0 || !dst) return 0;
+    while (pos < len) {
+        uint64_t rem = len - pos;
+        size_t want = rem > (uint64_t)SSIZE_MAX ? (size_t)SSIZE_MAX : (size_t)rem;
+        ssize_t nread;
+        do {
+            nread = pread(fd, dst + pos, want, (off_t)(offset + pos));
+        } while (nread < 0 && errno == EINTR);
+        if (nread <= 0) break;
+        pos += (uint64_t)nread;
+    }
+    if (out_read) *out_read = pos;
+    return pos == len;
+}
+
+static void *ds4_stripe_pool_worker(void *arg) {
+    ds4_stripe_part_pool *pool = (ds4_stripe_part_pool *)arg;
+    for (;;) {
+        pthread_mutex_lock(&pool->mutex);
+        while (!pool->shutdown && pool->head == NULL) {
+            pthread_cond_wait(&pool->cond, &pool->mutex);
+        }
+        if (pool->shutdown && pool->head == NULL) {
+            pthread_mutex_unlock(&pool->mutex);
+            break;
+        }
+        ds4_stripe_subtask_node *node = pool->head;
+        pool->head = node->next;
+        if (!pool->head) pool->tail = NULL;
+        pthread_mutex_unlock(&pool->mutex);
+
+        node->next = NULL;
+        uint32_t part_index = node->part_index;
+        int fd = (part_index < g_n_parts) ? g_parts[part_index].fd : -1;
+        uint64_t got = 0;
+        int ok = ds4_stripe_pread_exact(fd, node->file_off, node->len, node->dst, &got);
+
+        ds4_stripe_join *join = node->join;
+        pthread_mutex_lock(&join->mutex);
+        if (!ok) join->all_ok = 0;
+        if (join->remaining > 0) join->remaining--;
+        if (join->remaining == 0) pthread_cond_signal(&join->cond);
+        pthread_mutex_unlock(&join->mutex);
+
+        free(node);
+    }
+    return NULL;
+}
+
+static uint32_t ds4_stripe_threads_per_part(void) {
+    uint32_t threads = 4;
+    const char *env = getenv("DS4_STRIPE_THREADS_PER_PART");
+    if (env && env[0]) {
+        char *end = NULL;
+        unsigned long v = strtoul(env, &end, 10);
+        if (end != env && *end == '\0' && v > 0) {
+            threads = v > 32 ? 32 : (uint32_t)v;
+        }
+    }
+    return threads;
+}
+
+static int ds4_stripe_pool_start(ds4_stripe_part_pool *pool, uint32_t n_threads) {
+    pthread_mutex_init(&pool->mutex, NULL);
+    pthread_cond_init(&pool->cond, NULL);
+    pool->head = pool->tail = NULL;
+    pool->shutdown = 0;
+    pool->n_threads = n_threads;
+    pool->threads = (pthread_t *)calloc(n_threads, sizeof(pthread_t));
+    if (!pool->threads) return 0;
+    uint32_t i;
+    for (i = 0; i < n_threads; i++) {
+        if (pthread_create(&pool->threads[i], NULL, ds4_stripe_pool_worker, pool) != 0) {
+            pool->n_threads = i;
+            return 0;
+        }
+    }
+    pool->started = 1;
+    return 1;
+}
+
+static void ds4_stripe_pool_stop(ds4_stripe_part_pool *pool) {
+    if (!pool->started) return;
+    pthread_mutex_lock(&pool->mutex);
+    pool->shutdown = 1;
+    pthread_cond_broadcast(&pool->cond);
+    pthread_mutex_unlock(&pool->mutex);
+    uint32_t i;
+    for (i = 0; i < pool->n_threads; i++) {
+        pthread_join(pool->threads[i], NULL);
+    }
+    free(pool->threads);
+    pool->threads = NULL;
+    /* drain any leftover queue (shouldn't happen once all joins waited) */
+    ds4_stripe_subtask_node *n = pool->head;
+    while (n) {
+        ds4_stripe_subtask_node *next = n->next;
+        free(n);
+        n = next;
+    }
+    pthread_mutex_destroy(&pool->mutex);
+    pthread_cond_destroy(&pool->cond);
+    memset(pool, 0, sizeof(*pool));
+}
+
+static void ds4_stripe_pool_submit(uint32_t part_index, uint64_t file_off,
+                                   uint64_t len, uint8_t *dst,
+                                   ds4_stripe_join *join) {
+    ds4_stripe_subtask_node *node =
+        (ds4_stripe_subtask_node *)malloc(sizeof(ds4_stripe_subtask_node));
+    node->part_index = part_index;
+    node->file_off = file_off;
+    node->len = len;
+    node->dst = dst;
+    node->join = join;
+    node->next = NULL;
+
+    ds4_stripe_part_pool *pool = &g_pools[part_index];
+    pthread_mutex_lock(&pool->mutex);
+    if (pool->tail) {
+        pool->tail->next = node;
+    } else {
+        pool->head = node;
+    }
+    pool->tail = node;
+    pthread_cond_signal(&pool->cond);
+    pthread_mutex_unlock(&pool->mutex);
+}
+
+/* ------------------------------------------------------------------ */
+/* Loading / teardown.                                                  */
+/* ------------------------------------------------------------------ */
+
+static void ds4_stripe_free_state_locked(void) {
+    uint32_t i;
+    for (i = 0; i < g_n_parts; i++) {
+        ds4_stripe_pool_stop(&g_pools[i]);
+        if (g_parts[i].fd >= 0) close(g_parts[i].fd);
+        free(g_parts[i].file);
+        free(g_parts[i].role);
+    }
+    memset(g_parts, 0, sizeof(g_parts));
+    memset(g_pools, 0, sizeof(g_pools));
+    g_n_parts = 0;
+    free(g_slices);
+    g_slices = NULL;
+    g_n_slices = 0;
+    g_align = 16384;
+    g_enabled = 0;
+}
+
+void ds4_stripe_reset(void) {
+    pthread_mutex_lock(&g_admin_mutex);
+    ds4_stripe_free_state_locked();
+    g_last_error[0] = '\0';
+    pthread_mutex_unlock(&g_admin_mutex);
+    /* Allow ensure_loaded() to try again (mainly relevant for tests that
+     * call pthread_once indirectly via ds4_stripe_ensure_loaded -- tests
+     * should use ds4_stripe_load_manifest() directly instead, since
+     * pthread_once cannot be re-armed portably). */
+}
+
+static int ds4_stripe_slice_cmp(const void *a, const void *b) {
+    const ds4_stripe_slice *sa = (const ds4_stripe_slice *)a;
+    const ds4_stripe_slice *sb = (const ds4_stripe_slice *)b;
+    if (sa->off < sb->off) return -1;
+    if (sa->off > sb->off) return 1;
+    return 0;
+}
+
+static char *ds4_read_whole_file(const char *path, size_t *out_len) {
+    FILE *f = fopen(path, "rb");
+    if (!f) return NULL;
+    if (fseek(f, 0, SEEK_END) != 0) { fclose(f); return NULL; }
+    long sz = ftell(f);
+    if (sz < 0) { fclose(f); return NULL; }
+    if (fseek(f, 0, SEEK_SET) != 0) { fclose(f); return NULL; }
+    char *buf = (char *)malloc((size_t)sz + 1);
+    if (!buf) { fclose(f); return NULL; }
+    size_t got = fread(buf, 1, (size_t)sz, f);
+    fclose(f);
+    if (got != (size_t)sz) { free(buf); return NULL; }
+    buf[sz] = '\0';
+    if (out_len) *out_len = (size_t)sz;
+    return buf;
+}
+
+bool ds4_stripe_load_manifest(const char *path) {
+    pthread_mutex_lock(&g_admin_mutex);
+    ds4_stripe_free_state_locked();
+    g_last_error[0] = '\0';
+
+    size_t flen = 0;
+    char *text = ds4_read_whole_file(path, &flen);
+    if (!text) {
+        ds4_stripe_set_error("cannot read manifest '%s': %s", path, strerror(errno));
+        pthread_mutex_unlock(&g_admin_mutex);
+        return false;
+    }
+
+    ds4_jvalue *root = ds4_jparse(text, flen);
+    free(text);
+    if (!root || root->type != JV_OBJ) {
+        ds4_stripe_set_error("manifest '%s' is not a JSON object", path);
+        ds4_jv_free(root);
+        pthread_mutex_unlock(&g_admin_mutex);
+        return false;
+    }
+
+    g_align = ds4_jnum_u64(ds4_jobj_get(root, "align"), 16384);
+    if (g_align == 0) g_align = 1;
+
+    /* Optional source sanity check: fail closed if the recorded source
+     * file no longer matches (size mismatch => stale manifest). */
+    const ds4_jvalue *source = ds4_jobj_get(root, "source");
+    if (source) {
+        const char *spath = ds4_jstr(ds4_jobj_get(source, "path"), NULL);
+        uint64_t ssize = ds4_jnum_u64(ds4_jobj_get(source, "size"), 0);
+        if (spath && ssize) {
+            struct stat st;
+            if (stat(spath, &st) != 0) {
+                ds4_stripe_set_error("manifest source '%s' not found: %s", spath, strerror(errno));
+                ds4_jv_free(root);
+                pthread_mutex_unlock(&g_admin_mutex);
+                return false;
+            }
+            if ((uint64_t)st.st_size != ssize) {
+                ds4_stripe_set_error(
+                    "manifest source size mismatch for '%s': manifest=%llu actual=%llu (stale manifest?)",
+                    spath, (unsigned long long)ssize, (unsigned long long)st.st_size);
+                ds4_jv_free(root);
+                pthread_mutex_unlock(&g_admin_mutex);
+                return false;
+            }
+        }
+    }
+
+    const ds4_jvalue *parts = ds4_jobj_get(root, "parts");
+    if (!parts || parts->type != JV_ARR || parts->n_items == 0 ||
+        parts->n_items > DS4_STRIPE_MAX_PARTS) {
+        ds4_stripe_set_error("manifest '%s' has invalid 'parts' array", path);
+        ds4_jv_free(root);
+        pthread_mutex_unlock(&g_admin_mutex);
+        return false;
+    }
+    g_n_parts = (uint32_t)parts->n_items;
+    uint32_t threads_per_part = ds4_stripe_threads_per_part();
+    uint32_t i;
+    for (i = 0; i < g_n_parts; i++) {
+        const ds4_jvalue *pobj = parts->items[i];
+        const char *file = ds4_jstr(ds4_jobj_get(pobj, "file"), NULL);
+        const char *role = ds4_jstr(ds4_jobj_get(pobj, "role"), "sidecar");
+        if (!file) {
+            ds4_stripe_set_error("manifest '%s' part %u missing 'file'", path, i);
+            ds4_jv_free(root);
+            ds4_stripe_free_state_locked();
+            pthread_mutex_unlock(&g_admin_mutex);
+            return false;
+        }
+        g_parts[i].file = strdup(file);
+        g_parts[i].role = strdup(role);
+        g_parts[i].fd = open(file, O_RDONLY);
+        if (g_parts[i].fd < 0) {
+            ds4_stripe_set_error("manifest '%s' part %u: open('%s') failed: %s",
+                                 path, i, file, strerror(errno));
+            ds4_jv_free(root);
+            ds4_stripe_free_state_locked();
+            pthread_mutex_unlock(&g_admin_mutex);
+            return false;
+        }
+        if (!ds4_stripe_pool_start(&g_pools[i], threads_per_part)) {
+            ds4_stripe_set_error("manifest '%s' part %u: failed to start worker pool", path, i);
+            ds4_jv_free(root);
+            ds4_stripe_free_state_locked();
+            pthread_mutex_unlock(&g_admin_mutex);
+            return false;
+        }
+    }
+
+    const ds4_jvalue *slices = ds4_jobj_get(root, "slices");
+    if (!slices || slices->type != JV_ARR) {
+        ds4_stripe_set_error("manifest '%s' has invalid 'slices' array", path);
+        ds4_jv_free(root);
+        ds4_stripe_free_state_locked();
+        pthread_mutex_unlock(&g_admin_mutex);
+        return false;
+    }
+    g_n_slices = (uint32_t)slices->n_items;
+    g_slices = (ds4_stripe_slice *)calloc(g_n_slices ? g_n_slices : 1, sizeof(ds4_stripe_slice));
+    for (i = 0; i < g_n_slices; i++) {
+        const ds4_jvalue *sobj = slices->items[i];
+        ds4_stripe_slice *slice = &g_slices[i];
+        slice->off = ds4_jnum_u64(ds4_jobj_get(sobj, "off"), 0);
+        slice->len = ds4_jnum_u64(ds4_jobj_get(sobj, "len"), 0);
+        const ds4_jvalue *sparts = ds4_jobj_get(sobj, "parts");
+        if (!sparts || sparts->type != JV_ARR || sparts->n_items == 0 ||
+            sparts->n_items > DS4_STRIPE_MAX_PARTS) {
+            ds4_stripe_set_error("manifest '%s' slice %u has invalid 'parts'", path, i);
+            ds4_jv_free(root);
+            ds4_stripe_free_state_locked();
+            pthread_mutex_unlock(&g_admin_mutex);
+            return false;
+        }
+        slice->n_parts = (uint32_t)sparts->n_items;
+        uint64_t sum_len = 0;
+        uint32_t j;
+        for (j = 0; j < slice->n_parts; j++) {
+            const ds4_jvalue *spobj = sparts->items[j];
+            slice->parts[j].part_index = ds4_jnum_u32(ds4_jobj_get(spobj, "part"), 0);
+            slice->parts[j].file_off = ds4_jnum_u64(ds4_jobj_get(spobj, "file_off"), 0);
+            slice->parts[j].len = ds4_jnum_u64(ds4_jobj_get(spobj, "len"), 0);
+            sum_len += slice->parts[j].len;
+            if (slice->parts[j].part_index >= g_n_parts) {
+                ds4_stripe_set_error("manifest '%s' slice %u references unknown part %u",
+                                     path, i, slice->parts[j].part_index);
+                ds4_jv_free(root);
+                ds4_stripe_free_state_locked();
+                pthread_mutex_unlock(&g_admin_mutex);
+                return false;
+            }
+        }
+        if (sum_len != slice->len) {
+            ds4_stripe_set_error(
+                "manifest '%s' slice %u part lengths sum to %llu, expected %llu",
+                path, i, (unsigned long long)sum_len, (unsigned long long)slice->len);
+            ds4_jv_free(root);
+            ds4_stripe_free_state_locked();
+            pthread_mutex_unlock(&g_admin_mutex);
+            return false;
+        }
+    }
+    qsort(g_slices, g_n_slices, sizeof(ds4_stripe_slice), ds4_stripe_slice_cmp);
+
+    ds4_jv_free(root);
+    g_enabled = 1;
+    fprintf(stderr,
+            "ds4: stripe manifest loaded '%s' parts=%u slices=%u align=%llu threads_per_part=%u\n",
+            path, g_n_parts, g_n_slices, (unsigned long long)g_align, threads_per_part);
+    pthread_mutex_unlock(&g_admin_mutex);
+    return true;
+}
+
+static void ds4_stripe_load_from_env(void) {
+    const char *path = getenv("DS4_STRIPE_MANIFEST");
+    if (!path || !path[0]) {
+        return; /* disabled: fully official, no manifest configured */
+    }
+    if (!ds4_stripe_load_manifest(path)) {
+        fprintf(stderr, "ds4: stripe manifest load failed: %s\n", ds4_stripe_last_error());
+        fprintf(stderr, "ds4: falling back to non-striped reads of the original GGUF\n");
+    }
+}
+
+bool ds4_stripe_ensure_loaded(void) {
+    pthread_once(&g_once, ds4_stripe_load_from_env);
+    return g_enabled != 0;
+}
+
+bool ds4_stripe_enabled(void) {
+    return g_enabled != 0;
+}
+
+uint32_t ds4_stripe_slice_count(void) { return g_n_slices; }
+uint32_t ds4_stripe_part_count(void) { return g_n_parts; }
+
+/* ------------------------------------------------------------------ */
+/* The hot-path read.                                                   */
+/* ------------------------------------------------------------------ */
+
+static double ds4_stripe_now_ms(void) {
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return (double)ts.tv_sec * 1000.0 + (double)ts.tv_nsec / 1e6;
+}
+
+static const ds4_stripe_slice *ds4_stripe_find_slice(uint64_t offset, uint64_t len) {
+    if (!g_slices || g_n_slices == 0) return NULL;
+    /* binary search on off, then require an exact [off,len) match --
+     * every real caller (ds4_gpu_stream_expert_pread_into) always asks
+     * for a whole expert-tensor slice, never a sub-range, so exact
+     * match is both correct and the fast path. */
+    uint32_t lo = 0, hi = g_n_slices;
+    while (lo < hi) {
+        uint32_t mid = lo + (hi - lo) / 2;
+        if (g_slices[mid].off < offset) {
+            lo = mid + 1;
+        } else {
+            hi = mid;
+        }
+    }
+    if (lo < g_n_slices && g_slices[lo].off == offset && g_slices[lo].len == len) {
+        return &g_slices[lo];
+    }
+    return NULL;
+}
+
+int ds4_stripe_try_pread(uint64_t offset,
+                         uint64_t len,
+                         uint8_t *dst,
+                         uint64_t *read_bytes,
+                         double   *ms_out,
+                         int      *ok) {
+    if (ok) *ok = 0;
+    if (!g_enabled || !dst || len == 0) return 0;
+
+    const ds4_stripe_slice *slice = ds4_stripe_find_slice(offset, len);
+    if (!slice) return 0; /* not a striped range -- caller falls back */
+
+    const double t0 = ds4_stripe_now_ms();
+
+    ds4_stripe_join join;
+    pthread_mutex_init(&join.mutex, NULL);
+    pthread_cond_init(&join.cond, NULL);
+    join.remaining = slice->n_parts;
+    join.all_ok = 1;
+
+    uint64_t cum = 0;
+    uint32_t j;
+    for (j = 0; j < slice->n_parts; j++) {
+        const ds4_stripe_slice_part *sp = &slice->parts[j];
+        ds4_stripe_pool_submit(sp->part_index, sp->file_off, sp->len, dst + cum, &join);
+        cum += sp->len;
+    }
+
+    pthread_mutex_lock(&join.mutex);
+    while (join.remaining != 0) {
+        pthread_cond_wait(&join.cond, &join.mutex);
+    }
+    int all_ok = join.all_ok;
+    pthread_mutex_unlock(&join.mutex);
+    pthread_mutex_destroy(&join.mutex);
+    pthread_cond_destroy(&join.cond);
+
+    const double dt = ds4_stripe_now_ms() - t0;
+    if (ms_out) *ms_out = dt;
+    if (read_bytes) *read_bytes = all_ok ? slice->len : 0;
+    if (ok) *ok = all_ok;
+    if (!all_ok) {
+        ds4_stripe_set_error(
+            "striped read failed for offset=%llu len=%llu (%u parts)",
+            (unsigned long long)offset, (unsigned long long)len, slice->n_parts);
+    }
+    return 1;
+}
+
+/* round10 (2026-09-26, task D): per-part F_RDADVISE for a known striped
+ * slice. See ds4_stripe.h for the contract. Deliberately does NOT go
+ * through the pool/join machinery ds4_stripe_try_pread() uses -- this is
+ * a fire-and-forget kernel hint, not a read that needs a completion
+ * signal, so a plain per-part fcntl() loop is both simpler and correct. */
+int ds4_stripe_try_readahead(uint64_t offset, uint64_t len) {
+    if (!g_enabled || len == 0) return 0;
+
+    const ds4_stripe_slice *slice = ds4_stripe_find_slice(offset, len);
+    if (!slice) return 0; /* not a striped range -- caller falls back */
+
+#if defined(F_RDADVISE)
+    uint32_t j;
+    for (j = 0; j < slice->n_parts; j++) {
+        const ds4_stripe_slice_part *sp = &slice->parts[j];
+        if (sp->part_index >= g_n_parts) continue;
+        const int fd = g_parts[sp->part_index].fd;
+        if (fd < 0) continue;
+
+        uint64_t pos = sp->file_off;
+        uint64_t rem = sp->len;
+        while (rem > 0) {
+            const uint64_t chunk64 =
+                rem > (uint64_t)INT_MAX ? (uint64_t)INT_MAX : rem;
+            if (pos > (uint64_t)LLONG_MAX) break;
+
+            struct radvisory ra;
+            ra.ra_offset = (off_t)pos;
+            ra.ra_count = (int)chunk64;
+            (void)fcntl(fd, F_RDADVISE, &ra);
+
+            pos += chunk64;
+            rem -= chunk64;
+        }
+    }
+#else
+    (void)slice;
+#endif
+    return 1;
+}
diff --git a/ds4_stripe.h b/ds4_stripe.h
new file mode 100644
index 0000000..9d33cea
--- /dev/null
+++ b/ds4_stripe.h
@@ -0,0 +1,105 @@
+#ifndef DS4_STRIPE_H
+#define DS4_STRIPE_H
+
+/*
+ * GLM-5.3 "stripe" reader: optional expert-slice striping across N drives
+ * for DS4's SSD-streaming routed-expert loader.
+ *
+ * Disabled unless DS4_STRIPE_MANIFEST points at a manifest written by
+ * tools/ds4_stripe_build.py. When disabled (or when a given byte range is
+ * not a known striped slice) every call is a fast no-op and the caller
+ * must fall back to its own plain pread of the original GGUF -- this is
+ * what keeps prefill full-layer reads and mmap'd views correct without
+ * any striping support of their own.
+ *
+ * This module is intentionally dependency-free (plain C99, pthreads,
+ * POSIX I/O only -- no Objective-C, no Metal, no Foundation) so it can be
+ * unit-tested on its own, without a GPU, without linking the rest of
+ * ds4_metal.m, and without a real GGUF file.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/* Idempotent, thread-safe, lazy load of DS4_STRIPE_MANIFEST (checked once
+ * via pthread_once). Returns true if striping is active after the call
+ * (a manifest was found and loaded successfully). Safe to call on every
+ * hot-path pread -- after the first call it's a single memory check. */
+bool ds4_stripe_ensure_loaded(void);
+
+/* True if striping is currently active. */
+bool ds4_stripe_enabled(void);
+
+/* Try to service a read of [offset, offset+len) -- coordinates in the
+ * *original* GGUF's byte space -- by fanning it out across the striped
+ * parts and waiting for all of them.
+ *
+ * Return value:
+ *   0 -- this exact [offset,len) range is not a known striped slice (or
+ *        striping is not active). The caller MUST fall back to its own
+ *        plain pread of the original file; the ok/read_bytes/ms_out
+ *        outputs are left untouched.
+ *   1 -- handled. ok-out tells success (1) or failure (0). On failure no
+ *        partial bytes should be trusted -- treat it exactly like any
+ *        other read failure (do not silently zero-fill).
+ *
+ * read_bytes-out and ms_out may be NULL if the caller doesn't want them.
+ */
+int ds4_stripe_try_pread(uint64_t offset,
+                         uint64_t len,
+                         uint8_t *dst,
+                         uint64_t *read_bytes,
+                         double   *ms_out,
+                         int      *ok);
+
+/* round10 (2026-09-26): readahead counterpart to ds4_stripe_try_pread(),
+ * for callers that want to hint the kernel (F_RDADVISE on Darwin; a no-op
+ * everywhere else) about an upcoming expert-slice read WITHOUT actually
+ * reading it yet. [offset, offset+len) is in the *original* GGUF's byte
+ * space, same convention as ds4_stripe_try_pread().
+ *
+ * Return value:
+ *   0 -- this exact [offset,len) range is not a known striped slice (or
+ *        striping is not active). The caller MUST fall back to its own
+ *        plain whole-range readahead of the original file.
+ *   1 -- handled: a separate F_RDADVISE was issued against each striped
+ *        part's own fd, for that part's own sub-range only, instead of
+ *        readahead-ing the whole logical range against a single file
+ *        (which would tell the OS to read bytes off ANY one drive that a
+ *        striped read never actually pulls from that drive). Always
+ *        "succeeds" in the sense of being handled -- F_RDADVISE is a
+ *        best-effort hint, not a correctness-bearing read, so individual
+ *        fcntl() failures are silently ignored exactly like
+ *        ds4_gpu_stream_expert_readahead_range() already does for the
+ *        non-striped case.
+ */
+int ds4_stripe_try_readahead(uint64_t offset, uint64_t len);
+
+/* ---- Test / diagnostics hooks (also usable by a real caller) ---- */
+
+/* Explicit load from a specific manifest path, bypassing the env var and
+ * the pthread_once guard. Returns true on success. NOT safe to call while
+ * another thread may be inside ds4_stripe_try_pread -- callers (tests)
+ * must quiesce traffic first. */
+bool ds4_stripe_load_manifest(const char *path);
+
+/* Release all resources (fds, worker threads, parsed manifest) and go
+ * back to the "disabled, not yet checked" state. Used between test
+ * cases; also NOT safe under concurrent traffic. */
+void ds4_stripe_reset(void);
+
+uint32_t ds4_stripe_slice_count(void);
+uint32_t ds4_stripe_part_count(void);
+
+/* Human-readable reason the last load/read failed, or "" if none. */
+const char *ds4_stripe_last_error(void);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* DS4_STRIPE_H */
